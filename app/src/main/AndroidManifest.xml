    <application android:label="Aabhix" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/aabhix_logo" android:allowBackup="false" android:dataExtractionRules="@xml/backup_rules" android:supportsRtl="true" android:usesCleartextTraffic="false">
